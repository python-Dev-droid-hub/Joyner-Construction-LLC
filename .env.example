# Public production origin (no trailing slash). Enables canonical, OG url, sitemap, and JSON-LD url/logo.
# Example: https://joyner-construction-llc-chi.vercel.app
# If unset on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback.
NEXT_PUBLIC_SITE_URL=

# --- Contact form (Nodemailer / SMTP) ---
# Required for live estimate emails:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=joynerconstllc@gmail.com
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASS=
# Optional overrides:
SMTP_FROM="Joyner Construction LLC <joynerconstllc@gmail.com>"
CONTACT_TO_EMAIL=joynerconstllc@gmail.com

# Optional fallbacks (used only if SMTP is not configured)
ESTIMATE_WEBHOOK_URL=
FORMSPREE_ENDPOINT=
